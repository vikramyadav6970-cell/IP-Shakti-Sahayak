# =============================================================================
# IP-SAKTI Sahayak — AI Layer Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — only .env.example belongs in version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Qdrant Cloud — Vector store (5 collections)
# Sign up: https://cloud.qdrant.io
# Create a free-tier cluster, then copy:
#   - Cluster URL (looks like https://xxxxx.aws.cloud.qdrant.io:6333)
#   - API key (Dashboard → Cluster → API Keys)
# ---------------------------------------------------------------------------
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ---------------------------------------------------------------------------
# Supabase — Relational DB (Postgres)
# Sign up: https://supabase.com
# Create a project, then go to:
#   Project Settings → Database → Connection string → Transaction mode
# Copy the full connection string (starts with postgresql://)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Upstash Redis — Cache, rate-limiting, Celery broker
# Sign up: https://console.upstash.com
# Create a Redis database, then go to:
#   Details → Connection → Redis URL (copy the rediss:// URL)
# ---------------------------------------------------------------------------
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ---------------------------------------------------------------------------
# LLM Provider — Choose one: openai | anthropic | gemini
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
# Google:    https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your-llm-api-key

# ---------------------------------------------------------------------------
# Embedding Model — Default: BAAI/bge-m3 (runs locally, 1024-dim, multilingual)
# No API key needed — downloaded from HuggingFace on first use.
# Only change this if you swap to a cloud embedding API.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# Cohere Rerank (OPTIONAL) — Cross-encoder reranker
# If set, the hybrid retriever uses Cohere Rerank instead of the local BGE
# reranker. Sign up: https://dashboard.cohere.com/api-keys
# Leave blank to use the local BGE cross-encoder reranker instead (free, no key).
# ---------------------------------------------------------------------------
COHERE_API_KEY=

# ---------------------------------------------------------------------------
# Neo4j AuraDB (OPTIONAL — only for Phase 5 stretch: knowledge graph)
# Sign up: https://neo4j.com/cloud/aura-free
# Leave blank until you reach T5.4.
# ---------------------------------------------------------------------------
NEO4J_URI=
NEO4J_PASSWORD=
